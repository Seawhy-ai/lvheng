[Unit]
Description=Lvheng classroom backend
After=network-online.target
Wants=network-online.target
[Service]
User=lvheng
Group=lvheng
WorkingDirectory=/opt/lvheng/aliyun-backend
ExecStart=/usr/bin/node --env-file=/etc/lvheng/backend.env /opt/lvheng/aliyun-backend/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lvheng
[Install]
WantedBy=multi-user.target
